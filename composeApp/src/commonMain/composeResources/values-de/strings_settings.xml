    <string name="keepalive_vendor_huawei">Huawei / Honor</string>
    <string name="keepalive_vendor_oppo">OPPO / OnePlus / realme</string>
    <string name="keepalive_vendor_vivo">vivo / iQOO</string>
    <string name="keepalive_vendor_samsung">Samsung</string>
    <string name="settings_experimental_jump_shell">Jump-Host-Shell</string>
    <string name="settings_experimental_jump_shell_desc">Das Verbindungsformular bietet an, einen Host zu erreichen, indem du an der Eingabeaufforderung seines Jump-Hosts ssh eintippst — für Bastions, die nur eine Shell erlauben. Eine Anmeldung am Jump-Host bedient alle solchen Tabs. Wenn aus, verbinden solche Profile auf diesem Gerät nicht.</string>
    <string name="settings_experimental_trusted_device">Vertrauenswürdiges Gerät</string>
    <string name="settings_experimental_trusted_device_desc">Fügt unter Sicherheit das Entsperren des Tresors über den System-Schlüsselbund hinzu. Ausschalten verwirft das Vertrauen.</string>
</resources>
